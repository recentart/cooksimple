{"id":"one-pan-chicken-and-rice","title":"One-Pan Chicken and Rice","url":"/recipes/one-pan-chicken-and-rice/","servings":4,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"chicken","group":null,"key":"boneless chicken thighs","item":"boneless, skinless chicken thighs","plural":null,"prep":null,"note":"about {count 6} thighs","amount":{"min":1.5,"max":1.5},"unit":"lb","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"boneless chicken thigh"},{"i":1,"id":"paprika","group":null,"key":"sweet paprika","item":"sweet paprika","plural":null,"prep":null,"note":"or smoked paprika","amount":{"min":2,"max":2},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":false,"shop":true,"one":"sweet paprika"},{"i":2,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":null,"note":null,"amount":{"min":1.5,"max":1.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":3,"id":"pepper","group":null,"key":"black pepper","item":"black pepper","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"black pepper"},{"i":4,"id":"oil","group":null,"key":"olive oil","item":"olive oil","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"olive oil"},{"i":5,"id":"onion","group":null,"key":"yellow onions","item":"yellow onion","plural":null,"prep":"diced","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"yellow onion"},{"i":6,"id":"garlic","group":null,"key":"garlic","item":"garlic","plural":null,"prep":"minced","note":null,"amount":{"min":4,"max":4},"unit":"clove","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"garlic"},{"i":7,"id":"rice","group":null,"key":"long-grain white rice","item":"long-grain white rice","plural":null,"prep":"rinsed and drained well","note":null,"amount":{"min":1.5,"max":1.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"long-grain white rice"},{"i":8,"id":"broth","group":null,"key":"chicken broth","item":"low-sodium chicken broth","plural":null,"prep":null,"note":null,"amount":{"min":2.75,"max":2.75},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"chicken broth"},{"i":9,"id":"peas","group":null,"key":"frozen peas","item":"frozen peas","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"frozen","pantry":false,"shop":true,"one":"frozen peas"},{"i":10,"id":"lemon","group":null,"key":"lemons","item":"lemon","plural":null,"prep":"zested, then cut into wedges","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"lemon"},{"i":11,"id":"parsley","group":null,"key":"fresh parsley","item":"fresh parsley","plural":null,"prep":"chopped","note":null,"amount":{"min":2,"max":2},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"fresh parsley"}],"steps":[{"text":"Stir together the paprika, salt and pepper. Pat the chicken dry with paper towels and rub half of the spice mix over both sides of the thighs.","uses":[1,2,3,0]},{"text":"Heat the oil in the skillet over medium-high heat until it shimmers. Lay the thighs in smooth side down and sear until deep golden, {time 4-5 min}. Flip and brown the other side for {time 3 min}. They will not be cooked through yet. Move them to a plate.","uses":[4,0]},{"text":"Lower the heat to medium. Add the onion to the fat in the pan and cook, stirring and scraping up the browned bits, until soft and lightly golden, {time 4-5 min}.","uses":[5]},{"text":"Add the rice, garlic and the rest of the spice mix. Stir until every grain is coated in fat and the rice smells lightly toasted, {time 2 min}.","uses":[7,6]},{"text":"Pour in the broth, scrape the bottom of the pan and bring to a boil. Nestle the chicken into the rice, browned side up, and pour in any juices from the plate.","uses":[8,0]},{"text":"Cover tightly, turn the heat to low and cook without lifting the lid for {time 20 min}. The liquid should be absorbed, the top of the rice dotted with small steam holes, and the thickest thigh should read at least {temp 165F internal}.","uses":[]},{"text":"Take the pan off the heat. Scatter the peas over the rice, cover again and let it stand for {time 10 min}. The trapped steam finishes the rice and warms the peas through.","uses":[9]},{"text":"Fluff the rice around the chicken with a fork. Scatter the lemon zest and parsley over the top and serve with the lemon wedges for squeezing.","uses":[10,11]}]}