{"id":"breakfast-burritos","title":"Breakfast Burritos","url":"/recipes/breakfast-burritos/","servings":6,"servingsLabel":"burritos","servingsLabelOne":"burrito","scaleOptions":[3,6,12],"ingredients":[{"i":0,"id":"potatoes","group":null,"key":"yukon gold potatoes","item":"Yukon Gold potatoes","plural":null,"prep":"cut into {len 1/2 in} cubes","note":null,"amount":{"min":1,"max":1},"unit":"lb","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"Yukon Gold potato"},{"i":1,"id":"oil","group":null,"key":"neutral oil","item":"neutral oil","plural":null,"prep":null,"note":null,"amount":{"min":2,"max":2},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"neutral oil"},{"i":2,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":null,"note":"divided","amount":{"min":1,"max":1},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":3,"id":"sausage","group":null,"key":"breakfast sausage","item":"breakfast sausage","plural":null,"prep":"removed from casings if needed","note":null,"amount":{"min":12,"max":12},"unit":"oz","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"breakfast sausage"},{"i":4,"id":"eggs","group":null,"key":"eggs","item":"large egg","plural":null,"prep":null,"note":null,"amount":{"min":8,"max":8},"unit":null,"dim":"count","scale":"whole","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"egg"},{"i":5,"id":"tortillas","group":null,"key":"flour tortillas","item":"large flour tortilla","plural":null,"prep":null,"note":"10-inch","amount":{"min":6,"max":6},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"bakery","pantry":false,"shop":true,"one":"flour tortilla"},{"i":6,"id":"cheese","group":null,"key":"cheddar cheese","item":"cheddar cheese","plural":null,"prep":"shredded","note":null,"amount":{"min":1.5,"max":1.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"cheddar cheese"},{"i":7,"id":"salsa","group":null,"key":"salsa","item":"salsa","plural":null,"prep":null,"note":null,"amount":{"min":0.75,"max":0.75},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"salsa"}],"steps":[{"text":"Heat the oil in the skillet over medium-high heat. Add the potatoes and half the salt and cook, turning every few minutes, until golden and tender, {time 12-15 min}. Move them to a large bowl.","uses":[1,0,2]},{"text":"Add the sausage to the same skillet and cook, breaking it into small crumbles, until browned with no pink left, {time 6-8 min}. Add it to the potatoes, leaving the fat behind.","uses":[3]},{"text":"Beat the eggs with the rest of the salt. Pour off all but a thin film of fat, lower the heat to medium-low and scramble the eggs until just set, {time 2-3 min}. Fold them into the potatoes and sausage.","uses":[4]},{"text":"Warm the tortillas in a dry skillet or in the microwave for a few seconds so they fold without cracking.","uses":[5]},{"text":"Divide the filling among the tortillas, top with the cheese and a spoonful of salsa, then fold in the sides and roll up tightly.","uses":[6,7]},{"text":"To crisp them, set the burritos seam side down in the skillet over medium heat and toast until golden, {time 2 min} per side.","uses":[]}]}