{"id":"tomato-basil-soup","title":"Tomato Basil Soup","url":"/recipes/tomato-basil-soup/","servings":4,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"butter","group":null,"key":"unsalted butter","item":"unsalted butter","plural":null,"prep":null,"note":null,"amount":{"min":2,"max":2},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":227,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"unsalted butter"},{"i":1,"id":"oil","group":null,"key":"olive oil","item":"olive oil","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"olive oil"},{"i":2,"id":"onion","group":null,"key":"yellow onions","item":"yellow onion","plural":null,"prep":"chopped","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"yellow onion"},{"i":3,"id":"garlic","group":null,"key":"garlic","item":"garlic","plural":null,"prep":"thinly sliced","note":null,"amount":{"min":3,"max":3},"unit":"clove","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"garlic"},{"i":4,"id":"tomatoes","group":null,"key":"canned whole tomatoes","item":"whole peeled tomatoes","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"can","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":{"amount":{"min":28,"max":28},"unit":"oz"},"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"canned whole tomatoes"},{"i":5,"id":"broth","group":null,"key":"vegetable broth","item":"vegetable broth","plural":null,"prep":null,"note":null,"amount":{"min":1.5,"max":1.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"vegetable broth"},{"i":6,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":"plus more to taste","note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":7,"id":"pepper","group":null,"key":"black pepper","item":"black pepper","plural":null,"prep":null,"note":null,"amount":{"min":0.25,"max":0.25},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"black pepper"},{"i":8,"id":"basil","group":null,"key":"fresh basil","item":"fresh basil leaves","plural":null,"prep":"loosely packed, plus a few small leaves for serving","note":null,"amount":{"min":0.5,"max":0.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"fresh basil"},{"i":9,"id":"cream","group":null,"key":"heavy cream","item":"heavy cream","plural":null,"prep":null,"note":null,"amount":{"min":0.25,"max":0.25},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"heavy cream"},{"i":10,"id":"sugar","group":null,"key":"granulated sugar","item":"granulated sugar","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":200,"size":null,"optional":true,"aisle":"baking","pantry":true,"shop":true,"one":"granulated sugar"}],"steps":[{"text":"Melt the butter with the oil in a large pot over medium heat. Add the onion and a pinch of the salt and cook, stirring now and then, until soft and translucent but not browned, {time 8-10 min}.","uses":[0,1,2,6]},{"text":"Add the garlic and cook, stirring, until fragrant and only just starting to color, about {time 1 min}. Keep it moving so it doesn't scorch.","uses":[3]},{"text":"Pour in the tomatoes and their juice, then break each tomato up against the side of the pot with a wooden spoon. Stir in the broth, the pepper and the rest of the salt, and bring to a boil.","uses":[4,5,7,6]},{"text":"Lower the heat, partly cover and simmer, stirring once or twice, until the tomatoes have collapsed and the soup has thickened slightly, {time 15-20 min}.","uses":[]},{"text":"Turn off the heat and stir in the basil. Blend until smooth with an immersion blender, keeping the blade under the surface. With a countertop blender, work in batches with the jar no more than half full and the lid's center cap removed, holding a folded towel over the opening so steam can escape instead of forcing the lid off.","uses":[8]},{"text":"Return the soup to the pot over low heat and stir in the cream. Warm it through without letting it boil, then taste and add more salt, plus the sugar if the soup tastes sharp. Serve topped with the reserved basil leaves.","uses":[9,10]}]}