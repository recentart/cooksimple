ded cheddar cheese","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"cheddar cheese"},{"i":12,"id":"salsa","group":"To serve","key":"salsa","item":"salsa","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"pantry","pantry":false,"shop":true,"one":"salsa"},{"i":13,"id":"sour-cream","group":"To serve","key":"sour cream","item":"sour cream","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"sour cream"},{"i":14,"id":"cilantro","group":"To serve","key":"fresh cilantro","item":"fresh cilantro","plural":null,"prep":"chopped","note":null,"amount":{"min":0.25,"max":0.25},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"fresh cilantro"},{"i":15,"id":"lime","group":"To serve","key":"limes","item":"lime","plural":null,"prep":"cut into wedges","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"lime"}],"steps":[{"text":"Set the skillet over medium-high heat and add the beef. Cook, breaking it into small crumbles with a spatula, until browned in spots with no pink left, {time 6-8 min}.","uses":[0]},{"text":"Tilt the pan and spoon off all but about {qty 1 tbsp} of the fat. Add the onion and cook, stirring, until softened, {time 3-4 min}.","uses":[1]},{"text":"Add the garlic, chili powder, cumin, oregano and salt and stir until fragrant, {time 30 sec}. Stir in the tomato paste and cook until it darkens slightly and coats the meat, {time 1 min}.","uses":[2,3,4,5,6,7]},{"text":"Pour in the water and scrape up the browned bits. Simmer, stirring now and then, until the liquid thickens and clings to the meat, {time 4-5 min}. A thermometer pushed into a mound of the meat should read at least {temp 160F internal}.","uses":[8]},{"text":"While the filling simmers, warm the tortillas one or two at a time in a dry skillet over medium-high heat until soft and lightly spotted, {time 30-60 sec} per side. Stack them in a clean kitchen towel to keep warm.","uses":[9]},{"text":"Taste the filling and add more salt if needed. Spoon it into the tortillas and top with lettuce, cheese, salsa, sour cream and cilantro, with lime wedges for squeezing.","uses":[9,10,11,12,13,14,15]}]}