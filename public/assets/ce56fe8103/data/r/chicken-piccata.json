bsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"fresh parsley"}],"steps":[{"text":"Slice each chicken breast horizontally into two thin cutlets and press them to about {len 1/4 in} thick. Season with the salt and pepper and dredge in the flour, shaking off the excess.","uses":[0,1,2,3]},{"text":"Heat the oil and 1 tbsp of the butter in the skillet over medium-high heat. Cook the cutlets in batches until golden and cooked through, {time 2-3 min} per side. Move to a plate.","uses":[4,5]},{"text":"Lower the heat to medium, add the garlic and stir for {time 30 sec}. Pour in the wine and scrape up the browned bits; simmer until mostly reduced, {time 1-2 min}.","uses":[6,7]},{"text":"Add the broth, lemon juice and capers and simmer until reduced by about a third, {time 3 min}. Take the pan off the heat and swirl in the remaining butter until the sauce is glossy.","uses":[8,9,10]},{"text":"Return the chicken and any juices to the pan, turn to coat in the sauce, and scatter with parsley. Serve with pasta, rice or crusty bread.","uses":[11]}]}