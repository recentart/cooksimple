gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"fine salt"},{"i":6,"id":"cinnamon","group":null,"key":"ground cinnamon","item":"ground cinnamon","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":false,"shop":true,"one":"ground cinnamon"},{"i":7,"id":"bananas","group":null,"key":"bananas","item":"medium ripe banana","plural":null,"prep":"well speckled","note":"about {qty 1 1/3 cup} mashed","amount":{"min":3,"max":3},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"banana"},{"i":8,"id":"sugar","group":null,"key":"light brown sugar","item":"light brown sugar","plural":null,"prep":"packed","note":null,"amount":{"min":0.6666666666666666,"max":0.6666666666666666},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":213,"size":null,"optional":false,"aisle":"baking","pantry":false,"shop":true,"one":"light brown sugar"},{"i":9,"id":"eggs","group":null,"key":"eggs","item":"large egg","plural":null,"prep":null,"note":null,"amount":{"min":2,"max":2},"unit":null,"dim":"count","scale":"whole","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"egg"},{"i":10,"id":"oil","group":null,"key":"neutral oil","item":"neutral oil","plural":null,"prep":null,"note":"or melted unsalted butter","amount":{"min":0.3333333333333333,"max":0.3333333333333333},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"neutral oil"},{"i":11,"id":"vanilla","group":null,"key":"vanilla extract","item":"vanilla extract","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"baking","pantry":false,"shop":true,"one":"vanilla extract"},{"i":12,"id":"walnuts","group":null,"key":"walnuts","item":"walnuts","plural":null,"prep":"chopped","note":null,"amount":{"min":0.5,"max":0.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"pantry","pantry":false,"shop":true,"one":"walnuts"}],"steps":[{"text":"Heat the oven to {temp 375F oven} with a rack in the middle. Line the muffin tin with paper liners, or grease the cups well.","uses":[]},{"text":"Stir the oats into the milk in a small bowl and let them soak while you mix everything else, about {time 10 min}. Soaking softens the oats so the muffins bake up tender rather than chewy.","uses":[0,1]},{"text":"In a medium bowl, whisk the flour, baking soda, baking powder, salt and cinnamon until evenly combined, so the leaveners are spread through the flour.","uses":[2,3,4,5,6]},{"text":"In a large bowl, mash the bananas with a fork until mostly smooth, with a few small lumps left. Whisk in the brown sugar, eggs, oil and vanilla until well combined.","uses":[7,8,9,10,11]},{"text":"Add the flour mixture and the soaked oats, along with any milk left in their bowl. Fold with a spatula just until no dry flour shows, then fold in the walnuts, if using. A lumpy batter bakes into tender muffins.","uses":[12]},{"text":"Divide the batter evenly among the muffin cups; they will be nearly full. Bake until the tops are golden and spring back when pressed and a toothpick in the center comes out clean or with a few moist crumbs, {time 18-22 min}.","uses":[]},{"text":"Let the muffins cool in the tin for {time 5 min}, then lift them onto a wire rack. Left in the hot tin, they steam and turn soggy underneath.","uses":[]}]}