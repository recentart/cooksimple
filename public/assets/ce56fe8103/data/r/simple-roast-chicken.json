{"id":"simple-roast-chicken","title":"Simple Roast Chicken","url":"/recipes/simple-roast-chicken/","servings":4,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"chicken","group":null,"key":"whole chicken","item":"whole chicken","plural":null,"prep":null,"note":"about {qty 4 lb}, patted dry","amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"whole chicken"},{"i":1,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":null,"note":null,"amount":{"min":2,"max":2},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":2,"id":"pepper","group":null,"key":"black pepper","item":"black pepper","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"black pepper"},{"i":3,"id":"butter","group":null,"key":"unsalted butter","item":"unsalted butter","plural":null,"prep":"softened","note":null,"amount":{"min":2,"max":2},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":227,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"unsalted butter"},{"i":4,"id":"lemon","group":null,"key":"lemons","item":"lemon","plural":null,"prep":"halved","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"lemon"},{"i":5,"id":"garlic","group":null,"key":"garlic","item":"garlic","plural":null,"prep":"halved crosswise","note":null,"amount":{"min":1,"max":1},"unit":"head","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"garlic"},{"i":6,"id":"thyme","group":null,"key":"fresh thyme","item":"fresh thyme","plural":null,"prep":null,"note":null,"amount":{"min":6,"max":6},"unit":"sprig","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"fresh thyme"},{"i":7,"id":"onion","group":null,"key":"yellow onions","item":"yellow onion","plural":null,"prep":"thickly sliced","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"yellow onion"}],"steps":[{"text":"If you have time, season the chicken all over with the salt up to a day ahead and leave it uncovered in the fridge; the skin dries and crisps better. Take it out {time 30 min notimer} before roasting.","uses":[0,1]},{"text":"Heat the oven to {temp 425F oven}. Spread the onion slices in the pan to make a rack for the chicken.","uses":[7]},{"text":"Pat the chicken dry, rub it with the butter and season with the pepper (and the salt, if you didn’t salt ahead). Put the lemon halves, garlic and thyme inside the cavity. Tie the legs together if you like.","uses":[2,3,4,5,6]},{"text":"Set the chicken on the onions, breast side up, and roast until the skin is deep golden and the thickest part of the thigh reads {temp 175F internal} (the breast at least {temp 160F internal}), {time 60-75 min}.","uses":[]},{"text":"Let the chicken rest on a board for {time 15 min} before carving; the juices settle and the breast finishes at {temp 165F internal}. Spoon the pan juices over the carved meat.","uses":[]}]}