,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"garlic"},{"i":6,"id":"thyme","group":null,"key":"fresh thyme","item":"fresh thyme or rosemary","plural":null,"prep":null,"note":null,"amount":{"min":4,"max":4},"unit":"sprig","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"fresh thyme"}],"steps":[{"text":"Pat the chops very dry and season all over with the salt and pepper. If you have time, leave them uncovered in the fridge for an hour or up to a day.","uses":[0,1,2]},{"text":"Heat the oil in the skillet over medium-high heat until shimmering. Add the chops and sear without moving until deeply browned, {time 4-5 min}.","uses":[3]},{"text":"Flip and lower the heat to medium. Add the butter, garlic and thyme.","uses":[4,5,6]},{"text":"Tilt the pan and spoon the foaming butter over the chops again and again until they read {temp 140F internal} near the bone, {time 4-6 min}.","uses":[]},{"text":"Rest the chops on a plate for {time 5 min}; they’ll rise to {temp 145F internal}, slightly pink and juicy. Spoon the garlic butter over them to serve.","uses":[]}]}