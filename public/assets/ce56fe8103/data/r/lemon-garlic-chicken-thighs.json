{"id":"lemon-garlic-chicken-thighs","title":"Lemon Garlic Chicken Thighs","url":"/recipes/lemon-garlic-chicken-thighs/","servings":4,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"chicken","group":null,"key":"bone-in chicken thighs","item":"bone-in, skin-on chicken thighs","plural":null,"prep":null,"note":"{count 6-8} thighs","amount":{"min":2,"max":2},"unit":"lb","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"bone-in chicken thigh"},{"i":1,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":null,"note":null,"amount":{"min":1.5,"max":1.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":2,"id":"pepper","group":null,"key":"black pepper","item":"black pepper","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"black pepper"},{"i":3,"id":"oil","group":null,"key":"olive oil","item":"olive oil","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"olive oil"},{"i":4,"id":"garlic","group":null,"key":"garlic","item":"garlic","plural":null,"prep":"lightly smashed and peeled","note":null,"amount":{"min":6,"max":6},"unit":"clove","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"garlic"},{"i":5,"id":"thyme","group":null,"key":"fresh thyme","item":"fresh thyme","plural":null,"prep":null,"note":"or {qty 1/2 tsp} dried thyme","amount":{"min":4,"max":4},"unit":"sprig","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"fresh thyme"},{"i":6,"id":"lemon","group":null,"key":"lemons","item":"lemon","plural":null,"prep":"thinly sliced, seeds removed","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"lemon"},{"i":7,"id":"broth","group":null,"key":"chicken broth","item":"chicken broth","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"chicken broth"},{"i":8,"id":"juice","group":null,"key":"lemon juice","item":"fresh lemon juice","plural":null,"prep":null,"note":"a juicy lemon gives 2 to 3 tbsp","amount":{"min":2,"max":2},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"lemon juice"},{"i":9,"id":"butter","group":null,"key":"unsalted butter","item":"unsalted butter","plural":null,"prep":null,"note":null,"amount":{"min":1,"max":1},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":227,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"unsalted butter"},{"i":10,"id":"parsley","group":null,"key":"fresh parsley","item":"fresh parsley","plural":null,"prep":"chopped","note":null,"amount":{"min":2,"max":2},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"fresh parsley"}],"steps":[{"text":"Heat the oven to {temp 425F oven} with a rack in the middle. Pat the chicken very dry with paper towels, then season both sides with the salt and pepper.","uses":[0,1,2]},{"text":"Heat the oil in the skillet over medium-high heat until it shimmers. Lay the thighs in skin side down and leave them alone until the skin is deep golden and lets go of the pan easily, {time 8-10 min}. Lower the heat a little if the fat starts to smoke.","uses":[3,0]},{"text":"Turn the thighs skin side up. Tuck the garlic, thyme and lemon slices into the gaps between them.","uses":[4,5,6]},{"text":"Move the skillet to the oven and roast until the thickest thigh reads {temp 175F internal} near the bone, {time 20-25 min}. Chicken is safe to eat from {temp 165F internal}, but thighs are juicier and more tender a little higher.","uses":[]},{"text":"Transfer the chicken to a plate. The skillet handle is now very hot, so grab it with an oven mitt. Pour off all but about {qty 1 tbsp fixed} of fat, set the skillet over medium heat and add the broth and lemon juice, scraping up the browned bits. Simmer until slightly reduced, {time 2-3 min}.","uses":[7,8]},{"text":"Take the skillet off the heat and swirl in the butter until melted. Spoon the sauce, garlic and lemon slices over the chicken and scatter the parsley on top.","uses":[9,10]}]}