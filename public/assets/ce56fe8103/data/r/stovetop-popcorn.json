{"id":"stovetop-popcorn","title":"Stovetop Popcorn","url":"/recipes/stovetop-popcorn/","servings":4,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"oil","group":null,"key":"neutral oil","item":"neutral oil","plural":null,"prep":null,"note":null,"amount":{"min":3,"max":3},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"neutral oil"},{"i":1,"id":"kernels","group":null,"key":"popcorn kernels","item":"popcorn kernels","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"popcorn kernels"},{"i":2,"id":"salt","group":null,"key":"fine salt","item":"fine salt","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"fine salt"}],"steps":[{"text":"Heat the oil in the pot over medium-high heat with {count 3} kernels in it. When all three pop, add the rest of the kernels in an even layer.","uses":[0,1]},{"text":"Take the pot off the heat, cover and count {time 30 sec}. This brings all the kernels to the same temperature so they pop together.","uses":[]},{"text":"Return to the heat with the lid slightly ajar to let steam out. Shake the pot now and then as the kernels pop.","uses":[]},{"text":"When the popping slows to one pop every few seconds, {time 2-3 min}, pour straight into a big bowl and toss with the salt.","uses":[2]}]}