{"id":"chicken-fried-rice","title":"Chicken Fried Rice","url":"/recipes/chicken-fried-rice/","servings":4,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"rice","group":null,"key":"cooked white rice","item":"cooked white rice","plural":null,"prep":"cold","note":"day-old rice fries best","amount":{"min":4,"max":4},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"cooked white rice"},{"i":1,"id":"chicken","group":null,"key":"boneless chicken thighs","item":"boneless, skinless chicken thighs","plural":null,"prep":"cut into {len 1/2 in} pieces","note":"or chicken breasts","amount":{"min":1,"max":1},"unit":"lb","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"boneless chicken thigh"},{"i":2,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":null,"note":null,"amount":{"min":0.5,"max":0.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":3,"id":"pepper","group":null,"key":"black pepper","item":"black pepper","plural":null,"prep":null,"note":null,"amount":{"min":0.25,"max":0.25},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"black pepper"},{"i":4,"id":"oil","group":null,"key":"neutral oil","item":"neutral oil","plural":null,"prep":"divided","note":null,"amount":{"min":3,"max":3},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"neutral oil"},{"i":5,"id":"eggs","group":null,"key":"eggs","item":"large egg","plural":null,"prep":"beaten","note":null,"amount":{"min":3,"max":3},"unit":null,"dim":"count","scale":"whole","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"egg"},{"i":6,"id":"onion","group":null,"key":"yellow onions","item":"yellow onion","plural":null,"prep":"diced","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"yellow onion"},{"i":7,"id":"green-onions","group":null,"key":"green onions","item":"green onion","plural":null,"prep":"thinly sliced, white and green parts kept separate","note":null,"amount":{"min":4,"max":4},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"green onion"},{"i":8,"id":"garlic","group":null,"key":"garlic","item":"garlic","plural":null,"prep":"minced","note":null,"amount":{"min":4,"max":4},"unit":"clove","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"garlic"},{"i":9,"id":"peas-carrots","group":null,"key":"frozen peas and carrots","item":"frozen peas and carrots","plural":null,"prep":null,"note":"no need to thaw","amount":{"min":1,"max":1},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"frozen","pantry":false,"shop":true,"one":"frozen peas and carrots"},{"i":10,"id":"soy","group":null,"key":"soy sauce","item":"soy sauce","plural":null,"prep":null,"note":null,"amount":{"min":3,"max":3},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"soy sauce"},{"i":11,"id":"sesame-oil","group":null,"key":"toasted sesame oil","item":"toasted sesame oil","plural":null,"prep":null,"note":null,"amount":{"min":2,"max":2},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":false,"shop":true,"one":"toasted sesame oil"}],"steps":[{"text":"Toss the chicken with the salt and pepper. Crumble the cold rice with your fingers so the grains are separate; clumps are hard to break up once they hit the hot pan.","uses":[1,2,3,0]},{"text":"Heat {qty 1 tbsp} of the oil in the skillet over medium-high heat until it shimmers. Add the chicken in a single layer and cook, stirring now and then, until browned with no pink inside, {time 5-6 min}. A piece should read {temp 165F internal}. Move it to a plate.","uses":[4,1]},{"text":"Lower the heat to medium. Pour the eggs into the fat left in the pan and stir gently until softly set but still a little glossy, about {time 1 min}. Add them to the plate with the chicken.","uses":[5]},{"text":"Turn the heat back to medium-high and add {qty 1 tbsp} of the oil. Stir-fry the onion and the white parts of the green onions until the onion softens, {time 3 min}. Add the garlic and stir until fragrant, {time 30 sec}.","uses":[4,6,7,8]},{"text":"Add the rest of the oil, then the rice. Press it into an even layer and leave it until it sizzles and some grains start to crisp, {time 1-2 min}. Stir, spread it out again and keep going until the rice is hot all the way through, {time 3-4 min}.","uses":[4,0]},{"text":"Stir in the peas and carrots, then return the chicken and eggs, breaking the eggs into small pieces. Drizzle the soy sauce around the edge of the pan and toss until the rice is evenly colored and the vegetables are hot, {time 2-3 min}.","uses":[9,1,5,10]},{"text":"Take the pan off the heat. Drizzle with the sesame oil, scatter the green onion tops over and toss once more. Taste and add a splash more soy sauce if it needs it.","uses":[11,7]}]}