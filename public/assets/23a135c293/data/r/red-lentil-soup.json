tional":false,"aisle":"produce","pantry":false,"shop":true,"one":"lemon juice"},{"i":12,"id":"parsley","group":null,"key":"fresh parsley","item":"fresh parsley","plural":null,"prep":"chopped","note":null,"amount":{"min":0.25,"max":0.25},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"fresh parsley"},{"i":13,"id":"flakes","group":null,"key":"red pepper flakes","item":"red pepper flakes","plural":null,"prep":"for serving","note":"or Aleppo pepper","amount":{"min":0.25,"max":0.25},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"spices","pantry":false,"shop":true,"one":"red pepper flakes"},{"i":14,"id":"lemon","group":null,"key":"lemons","item":"lemon","plural":null,"prep":"cut into wedges, for serving","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"lemon"}],"steps":[{"text":"Heat {qty 2 tbsp} of the oil in a large pot over medium heat. Add the onion, carrot and a pinch of the salt, and cook, stirring often, until the onion is soft and golden at the edges, {time 8-10 min}.","uses":[0,1,2,9]},{"text":"Stir in the garlic, cumin and tomato paste. Cook, stirring constantly, until the paste darkens a shade and coats the vegetables, {time 1-2 min}.","uses":[3,4,5]},{"text":"Add the lentils, broth, water, pepper and the rest of the salt. Bring to a boil over high heat, skimming off any foam that rises to the top.","uses":[6,7,8,10,9]},{"text":"Lower the heat, partly cover and simmer, stirring now and then so the lentils don't catch on the bottom, until they have broken down completely and the carrot is very soft, {time 20-25 min}.","uses":[]},{"text":"Blend the soup until mostly smooth with an immersion blender, keeping the blade under the surface. With a countertop blender, work in batches with the jar no more than half full and the lid's center cap removed, holding a folded towel over the opening so steam can escape.","uses":[]},{"text":"Stir in the lemon juice. If the soup is thicker than you like, loosen it with a splash of water. Taste and add more salt if needed.","uses":[11,8]},{"text":"Ladle into bowls, drizzle with the rest of the oil and scatter the parsley and red pepper flakes on top. Serve with lemon wedges for squeezing.","uses":[0,12,13,14]}]}