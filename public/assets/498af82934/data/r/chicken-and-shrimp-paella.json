{"id":"chicken-and-shrimp-paella","title":"Chicken and Shrimp Paella","url":"/recipes/chicken-and-shrimp-paella/","servings":6,"servingsLabel":"servings","servingsLabelOne":"serving","scaleOptions":[2,4,6,8,10],"ingredients":[{"i":0,"id":"oil","group":null,"key":"olive oil","item":"olive oil","plural":null,"prep":null,"note":null,"amount":{"min":3,"max":3},"unit":"tbsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"pantry","pantry":true,"shop":true,"one":"olive oil"},{"i":1,"id":"chicken","group":null,"key":"boneless chicken thighs","item":"boneless, skinless chicken thighs","plural":null,"prep":"cut into chunks","note":null,"amount":{"min":1,"max":1},"unit":"lb","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"boneless chicken thigh"},{"i":2,"id":"salt","group":null,"key":"kosher salt","item":"kosher salt","plural":null,"prep":null,"note":"divided","amount":{"min":1.5,"max":1.5},"unit":"tsp","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"spices","pantry":true,"shop":true,"one":"kosher salt"},{"i":3,"id":"chorizo","group":null,"key":"spanish chorizo","item":"Spanish chorizo","plural":null,"prep":"sliced","note":null,"amount":{"min":4,"max":4},"unit":"oz","dim":"weight","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"meat-seafood","pantry":false,"shop":true,"one":"spanish chorizo"},{"i":4,"id":"onion","group":null,"key":"yellow onions","item":"yellow onion","plural":null,"prep":"finely chopped","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":false,"aisle":"produce","pantry":false,"shop":true,"one":"yellow onion"},{"i":5,"id":"pepper","group":null,"key":"red bell peppers","item":"red bell pepper","plural":null,"prep