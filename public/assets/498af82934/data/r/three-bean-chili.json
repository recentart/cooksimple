sPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"avocado"},{"i":17,"id":"cilantro","group":"To serve","key":"fresh cilantro","item":"fresh cilantro","plural":null,"prep":"chopped","note":null,"amount":{"min":0.25,"max":0.25},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"fresh cilantro"},{"i":18,"id":"green-onions","group":"To serve","key":"green onions","item":"green onion","plural":null,"prep":"thinly sliced","note":null,"amount":{"min":2,"max":2},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"green onion"},{"i":19,"id":"lime","group":"To serve","key":"limes","item":"lime","plural":null,"prep":"cut into wedges","note":null,"amount":{"min":1,"max":1},"unit":null,"dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"lime"}],"steps":[{"text":"Heat the oil in a large pot or Dutch oven over medium heat. Add the onion, bell pepper and a pinch of the salt, and cook, stirring now and then, until softened and starting to brown at the edges, {time 8-10 min}.","uses":[0,1,2,3]},{"text":"Stir in the garlic, chili powder, cumin, smoked paprika, oregano and tomato paste. Cook, stirring constantly, until the spices smell toasty and the paste darkens a shade, {time 1-2 min}.","uses":[4,5,6,7,8,9]},{"text":"Add the tomatoes and their juice, the broth, all three kinds of beans, the zucchini and the rest of the salt. Stir well, scraping up anything stuck to the bottom of the pot, and bring to a boil.","uses":[10,11,12,13,14,15,3]},{"text":"Lower the heat, partly cover and simmer, stirring every so often, until the chili has thickened and the zucchini is tender, {time 25-30 min}. If it gets thicker than you like, stir in a splash of water.","uses":[]},{"text":"For a thicker, creamier chili, mash a few spoonfuls of the beans against the side of the pot and stir them back in. Taste and add more salt if needed.","uses":[]},{"text":"Ladle into bowls and top with the avocado, cilantro and green onions. Serve with lime wedges for squeezing.","uses":[16,17,18,19]}]}