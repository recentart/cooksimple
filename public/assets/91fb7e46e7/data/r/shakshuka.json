im":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"dairy-eggs","pantry":false,"shop":true,"one":"feta cheese"},{"i":12,"id":"herbs","group":null,"key":"fresh cilantro","item":"fresh cilantro or parsley","plural":null,"prep":"chopped","note":null,"amount":{"min":0.25,"max":0.25},"unit":"cup","dim":"volume","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"produce","pantry":false,"shop":true,"one":"fresh cilantro"},{"i":13,"id":"bread","group":null,"key":"crusty bread","item":"crusty bread","plural":null,"prep":"for serving","note":null,"amount":{"min":8,"max":8},"unit":"slice","dim":"count","scale":"linear","scaleNote":null,"gramsPerCup":null,"size":null,"optional":true,"aisle":"bakery","pantry":false,"shop":true,"one":"crusty bread"}],"steps":[{"text":"Heat the oil in the skillet over medium heat. Add the onion and bell pepper and cook, stirring now and then, until very soft and the onion is golden at the edges, {time 8-10 min}.","uses":[0,1,2]},{"text":"Add the garlic, cumin, paprika and red pepper flakes and stir until fragrant, {time 1 min}. Don't let the garlic brown.","uses":[3,4,5,6]},{"text":"Add the tomatoes and their juice, crushing the whole ones in the pan with a spoon or potato masher. Stir in {qty 1 tsp} of the salt and bring to a simmer.","uses":[7,8]},{"text":"Simmer, stirring occasionally, until the sauce is thick enough that a spoon dragged through it leaves a path that holds for a moment, {time 10-12 min}. Taste and add more salt if needed.","uses":[]},{"text":"Turn the heat to medium-low. Make a small well in the sauce for each egg with the back of a spoon and crack an egg into each one. Sprinkle the eggs with the rest of the salt and the black pepper.","uses":[10,8,9]},{"text":"Cover the pan and cook until the egg whites are set and the yolks are still soft, {time 5-8 min}. Check often near the end; yolks go from runny to firm quickly.","uses":[]},{"text":"Take the pan off the heat. Scatter the feta and herbs over the top and serve straight from the pan with the bread for scooping.","uses":[11,12,13]}]}