      {"id": "peas", "amount": "1", "unit": "cup", "item": "frozen peas", "key": "frozen peas"}
    ] }
  ],
  "steps": [
    {"text": "Heat the oil in the skillet over medium heat. Cook the onion, carrots and mushrooms until soft and the mushroom liquid evaporates, {time 10 min}. Stir in the garlic and tomato paste for {time 1 min}.", "uses": ["oil", "onion", "carrots", "mushrooms", "garlic", "paste"]},
    {"text": "Add the lentils, broth, soy sauce, thyme and salt. Simmer, partly covered, until the lentils are tender and the liquid has thickened to a gravy, {time 30-35 min}. Stir in the peas.", "uses": ["lentils", "broth", "soy", "thyme", "salt", "peas"]},
    {"text": "Meanwhile boil the potatoes in salted water until very tender, {time 15-18 min}. Drain and mash with the butter, warm milk and salt.", "uses": ["potatoes", "butter", "milk", "psalt"]},
    {"text": "Heat the oven to {temp 400F oven}. Spread the lentil filling in the baking dish, top with the mash and rough up the surface with a fork.", "uses": []},
    {"text": "Bake until bubbling at the edges and golden on top, {time 20-25 min}. Rest for {time 10 min} before serving.", "uses": []}
  ],
  "notes": [
    "Use plant milk and olive oil in the mash for a vegan pie."
  ]
}
