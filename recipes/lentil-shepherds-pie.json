  "ingredients": [
    { "group": "For the topping", "items": [
      {"id": "potatoes", "amount": "2 1/2", "unit": "lb", "item": "russet potatoes", "key": "russet potatoes", "prep": "peeled and cut into chunks"},
      {"id": "butter", "amount": "4", "unit": "tbsp", "item": "unsalted butter", "key": "unsalted butter"},
      {"id": "milk", "amount": "1/2", "unit": "cup", "item": "milk", "key": "milk", "prep": "warm"},
      {"id": "psalt", "amount": "1", "unit": "tsp", "item": "kosher salt", "key": "kosher salt"}
    ] },
    { "group": "For the filling", "items": [
      {"id": "oil", "amount": "2", "unit": "tbsp", "item": "olive oil", "key": "olive oil"},
      {"id": "onion", "amount": "1", "item": "yellow onion", "key": "yellow onions", "prep": "diced"},
      {"id": "carrots", "amount": "2", "item": "carrot", "key": "carrots", "prep": "diced"},
      {"id": "mushrooms", "amount": "8", "unit": "oz", "item": "cremini mushrooms", "key": "cremini mushrooms", "prep": "chopped"},
      {"id": "garlic", "amount": "3", "unit": "clove", "item": "garlic", "key": "garlic", "prep": "minced"},
      {"id": "paste", "amount": "2", "unit": "tbsp", "item": "tomato paste", "key": "tomato paste"},
      {"id": "lentils", "amount": "1", "unit": "cup", "item": "green or brown lentils", "key": "green lentils", "prep": "rinsed"},
      {"id": "broth", "amount": "3", "unit": "cup", "item": "vegetable broth", "key": "vegetable broth"},
      {"id": "soy", "amount": "1", "unit": "tbsp", "item": "soy sauce", "key": "soy sauce"},
      {"id": "thyme", "amount": "1", "unit": "tsp", "item": "dried thyme", "key": "dried thyme"},
