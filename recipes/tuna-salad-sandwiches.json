  "steps": [
    {"text": "Flake the drained tuna into a bowl with a fork.", "uses": ["tuna"]},
    {"text": "Add the mayonnaise, celery, red onion, lemon juice, mustard and pepper and stir until evenly mixed. Taste, then add salt only if needed; canned tuna is already salted.", "uses": ["mayo", "celery", "onion", "lemon", "mustard", "pepper", "salt"]},
