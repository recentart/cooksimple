{
  "id": "chicken-salad-sandwiches",
  "title": "Chicken Salad Sandwiches",
  "description": "Tender poached chicken with crunchy celery, grapes and toasted pecans in a light lemony dressing, piled onto soft bread.",
  "added": "2026-09-25",
  "servings": 6,
  "servingsLabel": "sandwiches",
  "scaleOptions": [3,6,12],
  "prepMinutes": 15,
  "cookMinutes": 20,
  "totalMinutes": 60,
  "cuisine": "Southern",
  "mealTypes": ["lunch"],
  "diets": [],
  "tags": ["make-ahead"],
  "equipment": ["Medium saucepan"],
  "image": {"file": "chicken-salad-sandwiches.svg", "alt": "A chicken salad sandwich cut in half on a plate"},
  "source": {"type": "original"},
  "ingredients": [
    {"id": "chicken", "amount": "1 1/2", "unit": "lb", "item": "boneless, skinless chicken breasts", "key": "chicken breasts"},
    {"id": "psalt", "amount": "1", "unit": "tsp", "item": "kosher salt", "key": "kosher salt", "prep": "for poaching"},
    {"id": "mayo", "amount": "1/3", "unit": "cup", "item": "mayonnaise", "key": "mayonnaise"},
    {"id": "yogurt", "amount": "1/4", "unit": "cup", "item": "plain Greek yogurt", "key": "plain greek yogurt"},
    {"id": "lemon", "amount": "1", "unit": "tbsp", "item": "fresh lemon juice", "key": "lemon juice"},
    {"id": "mustard", "amount": "1", "unit": "tsp", "item": "Dijon mustard", "key": "dijon mustard"},
    {"id": "salt", "amount": "1/2", "unit": "tsp", "item": "kosher salt", "key": "kosher salt"},
    {"id": "pepper", "amount": "1/4", "unit": "tsp", "item": "black pepper", "key": "black pepper"},
    {"id": "celery", "amount": "2", "unit": "stalk", "item": "celery", "key": "celery", "prep": "diced"},
    {"id": "grapes", "amount": "1", "unit": "cup", "item": "red grapes", "key": "red grapes", "prep": "halved"},
    {"id": "pecans", "amount": "1/2", "unit": "cup", "item": "pecans", "key": "pecans", "prep": "toasted and chopped", "optional": true},
    {"id": "bread", "amount": "12", "unit": "slice", "item": "sandwich bread", "key": "sandwich bread"},
    {"id": "lettuce", "amount": "6", "item": "lettuce leaf", "key": "romaine lettuce", "plural": "lettuce leaves"}
  ],
  "steps": [
    {"text": "Put the chicken in the saucepan, cover with cold water by {len 1 in} and add the poaching salt. Bring to a bare simmer, then cover, turn the heat to low and cook until the chicken reaches {temp 165F internal}, {time 12-15 min}.", "uses": ["chicken", "psalt"]},
    {"text": "Let the chicken cool in its liquid for {time 10 min} so it stays juicy, then lift it out and chop or shred it. Let it cool completely.", "uses": []},
    {"text": "Whisk the mayonnaise, yogurt, lemon juice, mustard, salt and pepper in a large bowl.", "uses": ["mayo", "yogurt", "lemon", "mustard", "salt", "pepper"]},
    {"text": "Fold in the chicken, celery, grapes and pecans. Taste and adjust the seasoning.", "uses": ["celery", "grapes", "pecans"]},
    {"text": "Serve on bread with lettuce, or chill for up to 3 days.", "uses": ["bread", "lettuce"]}
  ],
  "notes": [
    "Leftover roast chicken or a store rotisserie chicken (about 4 cups meat) works in place of poaching."
  ]
}
