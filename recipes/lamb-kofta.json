  "source": {"type": "original"},
  "ingredients": [
    {"id": "lamb", "amount": "1 1/2", "unit": "lb", "item": "ground lamb", "key": "ground lamb", "note": "or half lamb, half beef"},
    {"id": "onion", "amount": "1/2", "item": "yellow onion", "key": "yellow onions", "prep": "grated and squeezed dry"},
    {"id": "garlic", "amount": "3", "unit": "clove", "item": "garlic", "key": "garlic", "prep": "grated"},
    {"id": "parsley", "amount": "1/3", "unit": "cup", "item": "fresh parsley", "key": "fresh parsley", "prep": "finely chopped"},
    {"id": "cumin", "amount": "2", "unit": "tsp", "item": "ground cumin", "key": "ground cumin"},
    {"id": "coriander", "amount": "1", "unit": "tsp", "item": "ground coriander", "key": "ground coriander"},
    {"id": "paprika", "amount": "1", "unit": "tsp", "item": "sweet paprika", "key": "sweet paprika"},
    {"id": "cinnamon", "amount": "1/2", "unit": "tsp", "item": "ground cinnamon", "key": "ground cinnamon"},
    {"id": "salt", "amount": "1 1/4", "unit": "tsp", "item": "kosher salt", "key": "kosher salt"},
    {"id": "yogurt", "amount": "3/4", "unit": "cup", "item": "plain Greek yogurt", "key": "plain greek yogurt"},
    {"id": "lemon", "amount": "1", "unit": "tbsp", "item": "fresh lemon juice", "key": "lemon juice"},
    {"id": "mint", "amount": "1", "unit": "tbsp", "item": "fresh mint", "key": "fresh mint", "prep": "chopped"},
    {"id": "pita", "amount": "4", "item": "pita", "key": "pita bread", "plural": "pitas", "optional": true}
  ],
  "steps": [
    {"text": "Mix the lamb, onion, garlic, parsley, cumin, coriander, paprika, cinnamon and salt with your hands until well combined and slightly sticky.", "uses": ["lamb", "onion", "garlic", "parsley", "cumin", "coriander", "paprika", "cinnamon", "salt"]},
    {"text": "Divide into {count 8} portions and shape each around a skewer into a log about {len 5 in} long. Chill for {time 15 min} to firm up.", "uses": []},
    {"text": "Stir the yogurt, lemon juice and mint with a pinch of salt.", "uses": ["yogurt", "lemon", "mint"]},
    {"text": "Heat the grill or broiler to high. Cook the kofta, turning a few times, until browned all over and they reach {temp 160F internal}, {time 8-10 min}.", "uses": []},
    {"text": "Serve with the yogurt sauce, warm pitas and a chopped tomato and cucumber salad.", "uses": ["pita"]}
  ],
  "notes": [
    "No skewers? Shape the mixture into small patties and cook them in a skillet."
  ]
