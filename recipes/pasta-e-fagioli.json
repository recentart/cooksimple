  "ingredients": [
    {"id": "oil", "amount": "3", "unit": "tbsp", "item": "olive oil", "key": "olive oil", "note": "plus more to serve"},
    {"id": "onion", "amount": "1", "item": "yellow onion", "key": "yellow onions", "prep": "diced"},
    {"id": "carrot", "amount": "1", "item": "carrot", "key": "carrots", "prep": "diced"},
    {"id": "celery", "amount": "1", "unit": "stalk", "item": "celery", "key": "celery", "prep": "diced"},
    {"id": "garlic", "amount": "4", "unit": "clove", "item": "garlic", "key": "garlic", "prep": "minced"},
    {"id": "rosemary", "amount": "1", "unit": "sprig", "item": "fresh rosemary", "key": "fresh rosemary"},
    {"id": "flakes", "amount": "1/4", "unit": "tsp", "item": "red pepper flakes", "key": "red pepper flakes"},
    {"id": "tomatoes", "amount": "1", "unit": "can", "size": "14.5 oz", "item": "diced tomatoes", "key": "canned diced tomatoes"},
    {"id": "beans", "amount": "2", "unit": "can", "size": "15 oz", "item": "cannellini or borlotti beans", "key": "canned cannellini beans", "prep": "drained and rinsed"},
    {"id": "broth", "amount": "5", "unit": "cup", "item": "vegetable broth", "key": "vegetable broth"},
    {"id": "salt", "amount": "1", "unit": "tsp", "item": "kosher salt", "key": "kosher salt"},
    {"id": "pasta", "amount": "1", "unit": "cup", "item": "small pasta such as ditalini", "key": "short pasta"},
