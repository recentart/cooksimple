{
  "id": "fish-tacos",
  "title": "Crispy Fish Tacos",
  "description": "Spiced, pan-seared white fish in warm tortillas with crunchy lime slaw and a cool lime crema. Ready in about 30 minutes.",
  "added": "2026-09-25",
  "servings": 4,
  "prepMinutes": 15,
